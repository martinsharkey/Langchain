{
  "folders": [
    {
      "path": ".",
      "name": "StrategyOps v2.0"
    }
  ],
  "settings": {
    // ====== Python Configuration ======
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "python.linting.flake8Args": [
      "--max-line-length=100",
      "--extend-ignore=E203,W503"
    ],
    "python.linting.mypyEnabled": true,
    "python.linting.mypyArgs": [
      "--ignore-missing-imports",
      "--check-untyped-defs"
    ],

    // ====== Formatting ======
    "[python]": {
      "editor.defaultFormatter": "ms-python.python",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
      }
    },
    "python.formatting.provider": "black",
    "python.formatting.blackArgs": [
      "--line-length=100"
    ],

    // ====== Editor Configuration ======
    "editor.fontSize": 12,
    "editor.fontFamily": "Fira Code, Consolas, monospace",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.trimAutoWhitespace": true,
    "editor.rulers": [
      80,
      100
    ],
    "editor.wordWrap": "off",

    // ====== Code Lens ======
    "python.analysis.extraPaths": [
      "${workspaceFolder}/src",
      "${workspaceFolder}/services"
    ],

    // ====== Testing ======
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
      "tests"
    ],

    // ====== File Associations ======
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/*.egg-info": true,
      "**/.venv": true
    },
    "files.watcherExclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/node_modules": true,
      "**/venv": true,
      "**/archive": true
    },

    // ====== Git Configuration ======
    "git.ignoreLimitWarning": true,
    "git.autofetch": true,

    // ====== Extensions Settings ======
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.enablePytestSupport": true,
    "python.envFile": "${workspaceFolder}/.env",

    // ====== Search ======
    "search.exclude": {
      "**/.git": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/htmlcov": true,
      "**/venv": true,
      "**/archive": true
    },

    // ====== Terminal ======
    "terminal.integrated.fontSize": 11,
    "terminal.integrated.scrollback": 10000,

    // ====== Docker ======
    "docker.showPerformanceWarning": false
  },

  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "ms-python.debugpy",
      "GitHub.copilot",
      "eamodio.gitlens",
      "ms-vscode.makefile-tools",
      "ms-vscode-remote.remote-containers",
      "ms-docker.docker",
      "formulahendry.code-runner",
      "ms-vscode.remote-explorer",
      "redhat.vscode-yaml",
      "ms-kubernetes-tools.vscode-kubernetes-tools"
    ]
  },

  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: Discovery Service",
        "type": "python",
        "request": "launch",
        "module": "uvicorn",
        "args": [
          "app.main:app",
          "--reload",
          "--port",
          "8001"
        ],
        "jinja": true,
        "cwd": "${workspaceFolder}/services/discovery-service",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "name": "Python: Optimization Service",
        "type": "python",
        "request": "launch",
        "module": "uvicorn",
        "args": [
          "app.main:app",
          "--reload",
          "--port",
          "8002"
        ],
        "jinja": true,
        "cwd": "${workspaceFolder}/services/optimization-service",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "name": "Python: Run Tests",
        "type": "python",
        "request": "launch",
        "module": "pytest",
        "args": [
          "tests/",
          "-v",
          "--cov=src"
        ],
        "jinja": true,
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "name": "Python: Current File",
        "type": "python",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
        "justMyCode": true
      }
    ]
  },

  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Run all tests",
        "type": "shell",
        "command": "make",
        "args": ["test"],
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "presentation": {
          "echo": true,
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "Format code",
        "type": "shell",
        "command": "make",
        "args": ["format"],
        "group": "build"
      },
      {
        "label": "Lint code",
        "type": "shell",
        "command": "make",
        "args": ["lint"],
        "group": "build"
      },
      {
        "label": "Start services",
        "type": "shell",
        "command": "make",
        "args": ["up"],
        "isBackground": true,
        "problemMatcher": {
          "pattern": {
            "regexp": "^.*$",
            "file": 1,
            "location": 2,
            "message": 3
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*Starting.*",
            "endsPattern": "^.*started.*"
          }
        }
      }
    ]
  }
}
