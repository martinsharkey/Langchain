# ─── LLM Provider Configuration (LiteLLM Multi-Provider) ───
# At least ONE API key is recommended, but you can also use the
# API-key-free Kilo Gateway below which needs NO signup at all —
# just set USE_KILO_GATEWAY=true.

# ═══ Tier 0: API-key-free (no signup needed!) ═══
# Kilo Gateway works WITHOUT any API key. Just set the flag to "true".
# It is tried first since it costs nothing and needs no account.
# Free models: Nemotron 3 Super 120B, Ling 3.0 Flash, Laguna S 2.1, etc.
# Docs: https://kilo.ai/docs/gateway
USE_KILO_GATEWAY=true

# ═══ Tier 1: Primary (fastest, most reliable) ═══
# Groq API — free tier: 1,000 req/day, 30 req/min
# Get a free key: https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here

# ═══ Tier 2: Excellent free tiers (no credit card) ═══
# Google Gemini — very generous free tier: 15-30 RPM, 1,500 RPD
# Get a free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Cerebras — ultra-fast inference, 1M tokens/day free
# Sign up: https://cloud.cerebras.ai/
# CEREBRAS_API_KEY=your_cerebras_api_key_here

# Mistral AI — ~1B tokens/month free (Experiment plan)
# Sign up: https://console.mistral.ai
# MISTRAL_API_KEY=your_mistral_api_key_here

# ═══ Tier 3: Good free tiers (no credit card) ═══
# OpenRouter — ~22 free models, 20 RPM, 200 RPD
# Sign up: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# SambaNova — 20 RPM, 200K tokens/day
# Sign up: https://cloud.sambanova.ai/apis
# SAMBANOVA_API_KEY=your_sambanova_api_key_here

# Cohere — 1,000 req/month, 20 RPM
# Sign up: https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=your_cohere_api_key_here

# ═══ Tier 4: Moderate free tiers ═══
# Cloudflare Workers AI — 10,000 neurons/day
# Sign up: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# NVIDIA NIM — 40 RPM, free with developer program
# Sign up: https://build.nvidia.com/explore/discover
# NVIDIA_API_KEY=your_nvidia_api_key_here

# HuggingFace Inference — 100K credits/month
# Sign up: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# GitHub Models — free for all GitHub users, 50 RPD
# GITHUB_TOKEN=your_github_token_here

# ═══ Tier 5: Trial/credit-based ═══
# Together AI — free research models
# TOGETHER_API_KEY=your_together_api_key_here
# DeepSeek — 5M free tokens (30-day trial)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# AI21 Labs — trial credits
# AI21_API_KEY=your_ai21_api_key_here
# xAI / Grok — $25 signup credit
# XAI_API_KEY=your_xai_api_key_here

# Optional: Override the default Groq model
# GROQ_MODEL=llama-3.3-70b-versatile

